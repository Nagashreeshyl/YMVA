# `./ymva start` creates .env automatically with strong random secrets.
# This file only documents the settings; you rarely need to edit them by hand.

# Where the dashboard is served: ":80" locally, or your domain in production
# (set both with: ./ymva start --domain voice.yellowmetal.co).
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# First admin account, created only when no users exist yet (password min 10 characters).
ADMIN_EMAIL=admin@yellowmetal.co
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Secrets. Generated once; never change them after the first start.
# ENCRYPTION_KEY is a Fernet key: openssl rand -base64 32 | tr '+/' '-_'
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

TIMEZONE=Asia/Kolkata

# API processes. Each handles about 10 simultaneous calls; use about one per CPU core.
API_WORKERS=1
LOG_LEVEL=INFO
