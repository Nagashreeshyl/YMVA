#!/usr/bin/env bash
# YMVA — Yellow Metal Voice Agent. One command to run everything.
#
#   ./ymva start [--domain voice.example.com]   Build and start the full stack (Docker)
#   ./ymva stop | restart | status | logs [service]
#   ./ymva reset-admin                           Reset admin to ADMIN_EMAIL / ADMIN_PASSWORD in .env
#   ./ymva update                                Pull latest code and redeploy
#   ./ymva backup                                Save a database backup to ./backups
#   ./ymva dev                                   Run locally with hot reload (no Docker)
#   ./ymva test                                  Run all checks and tests
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Docker Desktop on macOS may install its CLI outside PATH (e.g. ~/.docker/bin).
for dir in "$HOME/.docker/bin" "$HOME/Applications/Docker.app/Contents/Resources/bin" \
  "/Applications/Docker.app/Contents/Resources/bin"; do
  [ -x "$dir/docker" ] && case ":$PATH:" in *":$dir:"*) ;; *) PATH="$dir:$PATH" ;; esac
done
export PATH
ENV_FILE="$ROOT/.env"
cd "$ROOT"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
fail() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

env_get() { [ -f "$ENV_FILE" ] && grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true; }

env_set() {
  local key="$1" value="$2"
  if grep -qE "^$key=" "$ENV_FILE" 2>/dev/null; then
    local tmp; tmp="$(mktemp)"
    awk -v k="$key" -v v="$value" -F= 'BEGIN{OFS="="} $1==k {print k, v; next} {print}' "$ENV_FILE" >"$tmp"
    mv "$tmp" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}

rand() { openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c "${1:-32}"; }
fernet_key() { openssl rand -base64 32 | tr '+/' '-_'; }

# Creates .env with strong random secrets on first run. Never overwrites existing values.
ensure_env() {
  command -v openssl >/dev/null || fail "openssl is required to generate secrets."
  if [ -f "$ENV_FILE" ]; then return; fi
  local admin_password; admin_password="$(rand 16)"
  umask 077
  cat >"$ENV_FILE" <<EOF
# YMVA configuration. Generated by ./ymva on $(date -u +%Y-%m-%dT%H:%M:%SZ). Keep this file private.

# Where the dashboard is served. For a real domain, run: ./ymva start --domain voice.yellowmetal.co
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# First admin account (used only when no users exist yet). Change the password after signing in.
ADMIN_EMAIL=admin@yellowmetal.co
ADMIN_NAME=Administrator
ADMIN_PASSWORD=$admin_password

# Generated secrets — do not share, do not change after first start.
SECRET_KEY=$(rand 48)
ENCRYPTION_KEY=$(fernet_key)
POSTGRES_PASSWORD=$(rand 32)
REDIS_PASSWORD=$(rand 32)

TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
EOF
  FIRST_RUN=1
  info "Created .env with new secrets."
}

need_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed. Install Docker Desktop (Mac/Windows) or Docker Engine (Linux), then run this again."
  docker info >/dev/null 2>&1 || fail "Docker is installed but not running. Start Docker, then run this again."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required (docker compose)."
}

compose() { docker compose --env-file "$ENV_FILE" -f "$ROOT/docker-compose.yml" "$@"; }

public_url() { env_get PUBLIC_URL; }

wait_ready() {
  local port; port="$(env_get HTTP_PORT)"
  local url; url="http://127.0.0.1:${port:-80}/api/health/ready"
  local site; site="$(env_get SITE_ADDRESS)"
  info "Waiting for YMVA to become ready..."
  for _ in $(seq 1 90); do
    if [ "$site" = ":80" ] || [ -z "$site" ]; then
      curl -fsS "$url" >/dev/null 2>&1 && return 0
    else
      curl -fsS "$(public_url)/api/health/ready" >/dev/null 2>&1 && return 0
    fi
    sleep 2
  done
  return 1
}

cmd_start() {
  local domain=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) domain="${2:-}"; shift 2 ;;
      *) fail "Unknown option: $1" ;;
    esac
  done
  need_docker
  FIRST_RUN=0
  ensure_env
  if [ -n "$domain" ]; then
    env_set SITE_ADDRESS "$domain"
    env_set PUBLIC_URL "https://$domain"
    info "Serving on https://$domain (HTTPS certificate is issued automatically)."
  fi
  bold "Starting YMVA..."
  compose up -d --build --remove-orphans
  if wait_ready; then
    echo
    bold "YMVA is running at $(public_url)"
    if [ "$FIRST_RUN" = "1" ]; then
      info "Sign in with:  $(env_get ADMIN_EMAIL)  /  $(env_get ADMIN_PASSWORD)"
      info "(Saved in .env. Change it in Settings → Your account after signing in.)"
    fi
  else
    compose ps
    fail "YMVA did not become ready in time. See logs with: ./ymva logs api"
  fi
}

cmd_backup() {
  need_docker
  mkdir -p "$ROOT/backups" && chmod 700 "$ROOT/backups"
  umask 077
  local file; file="$ROOT/backups/ymva-$(date +%Y%m%d-%H%M%S).sql.gz"
  compose exec -T postgres pg_dump -U ymva -d ymva --clean --if-exists | gzip >"$file"
  bold "Backup saved: $file"
}

cmd_update() {
  need_docker
  if git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    git -C "$ROOT" pull --ff-only
  fi
  cmd_backup
  compose up -d --build --remove-orphans
  wait_ready && bold "Updated. YMVA is running at $(public_url)"
}

dev_env() {
  export ENVIRONMENT=development PUBLIC_URL=http://localhost:3000
  export DATABASE_URL="${DEV_DATABASE_URL:-postgresql+asyncpg://ymva:ymva@localhost:5432/ymva}"
  export REDIS_URL="${DEV_REDIS_URL:-redis://localhost:6379/0}"
}

docker_api_running() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 &&
    [ -n "$(compose ps -q --status running api 2>/dev/null)" ]
}

cmd_reset_admin() {
  [ -f "$ENV_FILE" ] || fail "No .env yet. Run ./ymva start first."
  if docker_api_running; then
    # Recreate the API container so it picks up the current .env, then reset.
    compose up -d api >/dev/null
    compose exec -T api ymva reset-admin
  else
    dev_env
    (cd backend && uv run --quiet ymva reset-admin)
  fi
}

cmd_restart() {
  need_docker
  # `up -d` (not `restart`) so edits to .env are applied.
  compose up -d --remove-orphans
  wait_ready && bold "YMVA is running at $(public_url)"
}

# Local development without Docker: needs PostgreSQL and Redis running locally.
cmd_dev() {
  command -v uv >/dev/null || fail "uv is required: https://docs.astral.sh/uv/"
  command -v npm >/dev/null || fail "Node.js 22+ is required."
  FIRST_RUN=0
  ensure_env
  if command -v brew >/dev/null 2>&1; then
    brew services list 2>/dev/null | grep -qE '^redis\s+started' || brew services start redis >/dev/null 2>&1 || true
  fi
  command -v pg_isready >/dev/null && { pg_isready -q || fail "PostgreSQL is not running locally."; }
  command -v redis-cli >/dev/null && { redis-cli ping >/dev/null 2>&1 || fail "Redis is not running locally."; }

  dev_env
  (cd backend && uv sync --quiet)
  [ -d web/node_modules ] || (cd web && npm install --silent)

  bold "Starting YMVA in development mode..."
  (cd backend && exec uv run ymva serve --reload) &
  local api_pid=$!
  (cd web && exec npm run dev -- --port 3000) &
  local web_pid=$!
  trap 'kill $api_pid $web_pid 2>/dev/null; wait 2>/dev/null' INT TERM EXIT
  info "Dashboard: http://localhost:3000   API docs: http://localhost:8000/api/docs"
  [ "$FIRST_RUN" = "1" ] && info "Sign in with: $(env_get ADMIN_EMAIL) / $(env_get ADMIN_PASSWORD)"
  wait
}

cmd_test() {
  bold "Backend checks"
  (cd backend && uv run ruff check src tests && uv run ruff format --check src tests && uv run mypy src && uv run pytest -q)
  bold "Dashboard checks"
  (cd web && npm run lint && npx tsc --noEmit && npm run build >/dev/null)
  bold "All checks passed."
}

usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  stop) need_docker; compose down ;;
  restart) cmd_restart ;;
  reset-admin) cmd_reset_admin ;;
  status) need_docker; compose ps ;;
  logs) need_docker; shift; compose logs -f --tail=200 "$@" ;;
  update) cmd_update ;;
  backup) cmd_backup ;;
  dev) cmd_dev ;;
  test) cmd_test ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
