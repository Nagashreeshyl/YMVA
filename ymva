#!/usr/bin/env bash
# YMVA — Yellow Metal Voice Agent. One command to run everything.
#
#   ./ymva start [--domain voice.example.com]   Build and start the full stack (Docker)
#   ./ymva start --tunnel                        Same, plus a temporary public HTTPS address for test calls
#   ./ymva start --monitoring                    Also run Prometheus + Grafana (graphs; stays on)
#   ./ymva stop | restart | status | logs [service]
#   ./ymva reset-admin                           Reset admin to ADMIN_EMAIL / ADMIN_PASSWORD in .env
#   ./ymva update                                Pull latest code and redeploy
#   ./ymva backup                                Save a database backup to ./backups
#   ./ymva verify-backup [file]                  Prove a backup restores (into a scratch database)
#   ./ymva restore <file>                        Replace the database with a backup
#   ./ymva dev                                   Run locally with hot reload (no Docker)
#   ./ymva test                                  Run all checks and tests
#   ./ymva simulate [--calls N] [--agent NAME]   Spoken test calls on a fake phone network (uses AI credit)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Docker Desktop on macOS may install its CLI outside PATH (e.g. ~/.docker/bin).
for dir in "$HOME/.docker/bin" "$HOME/Applications/Docker.app/Contents/Resources/bin" \
  "/Applications/Docker.app/Contents/Resources/bin"; do
  [ -x "$dir/docker" ] && case ":$PATH:" in *":$dir:"*) ;; *) PATH="$dir:$PATH" ;; esac
done
export PATH
ENV_FILE="$ROOT/.env"
cd "$ROOT"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
fail() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

env_get() { [ -f "$ENV_FILE" ] && grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true; }

env_set() {
  local key="$1" value="$2"
  if grep -qE "^$key=" "$ENV_FILE" 2>/dev/null; then
    local tmp; tmp="$(mktemp)"
    awk -v k="$key" -v v="$value" -F= 'BEGIN{OFS="="} $1==k {print k, v; next} {print}' "$ENV_FILE" >"$tmp"
    mv "$tmp" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}

rand() { openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c "${1:-32}"; }
fernet_key() { openssl rand -base64 32 | tr '+/' '-_'; }

# Creates .env with strong random secrets on first run. Never overwrites existing values.
ensure_env() {
  command -v openssl >/dev/null || fail "openssl is required to generate secrets."
  if [ -f "$ENV_FILE" ]; then return; fi
  local admin_password; admin_password="$(rand 16)"
  umask 077
  cat >"$ENV_FILE" <<EOF
# YMVA configuration. Generated by ./ymva on $(date -u +%Y-%m-%dT%H:%M:%SZ). Keep this file private.

# Where the dashboard is served. For a real domain, run: ./ymva start --domain voice.yellowmetal.co
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# First admin account (used only when no users exist yet). Change the password after signing in.
ADMIN_EMAIL=admin@yellowmetal.co
ADMIN_NAME=Administrator
ADMIN_PASSWORD=$admin_password

# Generated secrets — do not share, do not change after first start.
SECRET_KEY=$(rand 48)
ENCRYPTION_KEY=$(fernet_key)
METRICS_TOKEN=$(rand 40)
POSTGRES_PASSWORD=$(rand 32)
REDIS_PASSWORD=$(rand 32)

TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
EOF
  FIRST_RUN=1
  info "Created .env with new secrets."
}

need_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed. Install Docker Desktop (Mac/Windows) or Docker Engine (Linux), then run this again."
  docker info >/dev/null 2>&1 || fail "Docker is installed but not running. Start Docker, then run this again."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required (docker compose)."
}

compose() { docker compose --env-file "$ENV_FILE" -f "$ROOT/docker-compose.yml" "$@"; }

public_url() { env_get PUBLIC_URL; }

wait_ready() {
  local port; port="$(env_get HTTP_PORT)"
  local url; url="http://127.0.0.1:${port:-80}/api/health/ready"
  local site; site="$(env_get SITE_ADDRESS)"
  info "Waiting for YMVA to become ready..."
  for _ in $(seq 1 90); do
    if [ "$site" = ":80" ] || [ -z "$site" ]; then
      curl -fsS "$url" >/dev/null 2>&1 && return 0
    else
      curl -fsS "$(public_url)/api/health/ready" >/dev/null 2>&1 && return 0
    fi
    sleep 2
  done
  return 1
}

cmd_start() {
  local domain="" tunnel=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) domain="${2:-}"; shift 2 ;;
      --tunnel) tunnel=1; shift ;;
      --monitoring) monitoring=1; shift ;;
      *) fail "Unknown option: $1" ;;
    esac
  done
  need_docker
  FIRST_RUN=0
  ensure_env
  # Installs from before the metrics token existed get one now.
  [ -n "$(env_get METRICS_TOKEN)" ] || env_set METRICS_TOKEN "$(rand 40)"
  if [ "${monitoring:-0}" = "1" ]; then
    env_set COMPOSE_PROFILES monitoring
    [ -n "$(env_get GRAFANA_PASSWORD)" ] || env_set GRAFANA_PASSWORD "$(rand 20)"
    info "Grafana: ssh -L 3001:localhost:3001 <server>, then http://localhost:3001 (admin / GRAFANA_PASSWORD in .env)"
  fi
  if [ -n "$domain" ]; then
    env_set SITE_ADDRESS "$domain"
    env_set PUBLIC_URL "https://$domain"
    info "Serving on https://$domain (HTTPS certificate is issued automatically)."
  fi
  if [ "$tunnel" = "0" ] && case "$(env_get TELEPHONY_PUBLIC_URL)" in *trycloudflare.com*|*ngrok*) true ;; *) false ;; esac; then
    env_set TELEPHONY_PUBLIC_URL ""
    COMPOSE_PROFILES=tunnel,ngrok compose rm -sf tunnel ngrok >/dev/null 2>&1 || true
  fi
  bold "Starting YMVA..."
  if [ "$tunnel" = "1" ] && [ -n "$(env_get NGROK_AUTHTOKEN)" ] && [ -n "$(env_get NGROK_DOMAIN)" ]; then
    # ngrok: a fixed address that stays up (the free Cloudflare one stalled live calls).
    local profiles="ngrok" extra; extra="$(env_get COMPOSE_PROFILES)"
    [ -n "$extra" ] && profiles="ngrok,$extra"
    COMPOSE_PROFILES=tunnel compose rm -sf tunnel >/dev/null 2>&1 || true
    COMPOSE_PROFILES="$profiles" compose up -d --build --remove-orphans
    start_ngrok
  elif [ "$tunnel" = "1" ]; then
    local profiles="tunnel" extra; extra="$(env_get COMPOSE_PROFILES)"
    [ -n "$extra" ] && profiles="tunnel,$extra"  # keep monitoring on if it is
    COMPOSE_PROFILES="$profiles" compose up -d --build --remove-orphans
    start_tunnel
  else
    compose up -d --build --remove-orphans
  fi
  if wait_ready; then
    echo
    bold "YMVA is running at $(public_url)"
    if [ "$FIRST_RUN" = "1" ]; then
      info "Sign in with:  $(env_get ADMIN_EMAIL)  /  $(env_get ADMIN_PASSWORD)"
      info "(Saved in .env. Change it in Settings → Your account after signing in.)"
    fi
  else
    compose ps
    fail "YMVA did not become ready in time. See logs with: ./ymva logs api"
  fi
}

start_ngrok() {
  local url; url="https://$(env_get NGROK_DOMAIN | sed -E 's#^https?://##; s#/.*$##')"
  env_set TELEPHONY_PUBLIC_URL "$url"
  compose up -d api >/dev/null  # recreate so the API picks up the address
  info "Opening $url through ngrok..."
  for _ in $(seq 1 30); do
    curl -fsS -m 10 "$url/api/health" >/dev/null 2>&1 && break
    sleep 2
  done
  curl -fsS -m 10 "$url/api/health" >/dev/null 2>&1 \
    || fail "ngrok didn't come up at $url. Check NGROK_AUTHTOKEN and NGROK_DOMAIN in .env, then: ./ymva logs ngrok"
  info "Public address for phone providers: $url (fixed: it stays the same across restarts)"
}

# Reads the quick-tunnel address from cloudflared's log and points telephony webhooks at it.
start_tunnel() {
  info "Opening a temporary public address..."
  local url=""
  # Cloudflare drops quick tunnels after a while while the container keeps running ("Tunnel
  # not found"). If the current address doesn't answer, start a fresh tunnel (new address).
  url="$(COMPOSE_PROFILES=tunnel compose logs tunnel 2>/dev/null | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1 || true)"
  if [ -n "$url" ] && ! curl -fsS -m 10 "$url/api/health" >/dev/null 2>&1; then
    info "The old public address has expired; opening a new one..."
    COMPOSE_PROFILES=tunnel compose up -d --force-recreate tunnel >/dev/null
  fi
  url=""
  for _ in $(seq 1 45); do
    url="$(COMPOSE_PROFILES=tunnel compose logs tunnel 2>/dev/null | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1 || true)"
    [ -n "$url" ] && break
    sleep 2
  done
  [ -n "$url" ] || fail "The tunnel didn't start. See: ./ymva logs tunnel"
  env_set TELEPHONY_PUBLIC_URL "$url"
  compose up -d api >/dev/null  # recreate so the API picks up the new address
  info "Public address for phone providers: $url"
  info "(It changes every time the tunnel restarts, and it can stall live calls. For steady test"
  info " calls add NGROK_AUTHTOKEN and NGROK_DOMAIN to .env; on a server use --domain.)"
}

cmd_backup() {
  need_docker
  mkdir -p "$ROOT/backups" && chmod 700 "$ROOT/backups"
  umask 077
  local file; file="$ROOT/backups/ymva-$(date +%Y%m%d-%H%M%S).sql.gz"
  compose exec -T postgres pg_dump -U ymva -d ymva --clean --if-exists </dev/null | gzip >"$file"
  bold "Backup saved: $file"
}

# Before restarting the API: pause new calls and let live ones finish, so no call is cut off.
drain_calls() {
  if docker_api_running; then
    info "Letting live calls finish first (new calls are paused; at most ${DRAIN_WAIT:-900}s)..."
    compose exec -T api ymva drain --wait "${DRAIN_WAIT:-900}" </dev/null || true
  fi
}

newest_backup() { ls -t "$ROOT"/backups/*.sql.gz 2>/dev/null | head -1; }

# Restores a backup into a throwaway database and counts what's in it; live data is untouched.
cmd_verify_backup() {
  need_docker
  local file="${1:-$(newest_backup)}"
  [ -n "$file" ] && [ -f "$file" ] || fail "No backup found in ./backups"
  info "Restoring $(basename "$file") into a scratch database..."
  compose exec -T postgres sh -c 'dropdb -U ymva --if-exists ymva_restore_check && createdb -U ymva ymva_restore_check' </dev/null
  gunzip -c "$file" | compose exec -T postgres psql -q -U ymva -d ymva_restore_check -v ON_ERROR_STOP=1 >/dev/null \
    || { compose exec -T postgres dropdb -U ymva --if-exists ymva_restore_check </dev/null; fail "The backup did not restore cleanly."; }
  compose exec -T postgres psql -U ymva -d ymva_restore_check -Atc \
    "select 'agents: ' || count(*) from agents union all select 'calls: ' || count(*) from calls union all select 'users: ' || count(*) from users union all select 'schema: ' || version_num from alembic_version" </dev/null
  compose exec -T postgres dropdb -U ymva ymva_restore_check </dev/null
  bold "Backup is good: $(basename "$file") restores cleanly."
}

# Replaces the live database with a backup (asks first; saves a backup of the current data).
cmd_restore() {
  need_docker
  local file="${1:-}"
  [ -n "$file" ] && [ -f "$file" ] || fail "Usage: ./ymva restore backups/<file>.sql.gz"
  cmd_verify_backup "$file"
  printf "This replaces ALL current data with %s. Type RESTORE to continue: " "$(basename "$file")"
  local answer; read -r answer
  [ "$answer" = "RESTORE" ] || fail "Cancelled."
  cmd_backup  # in case you need to go back
  drain_calls
  compose stop api web
  gunzip -c "$file" | compose exec -T postgres psql -q -U ymva -d ymva -v ON_ERROR_STOP=1 >/dev/null
  compose up -d api web
  wait_ready && bold "Restored $(basename "$file"). YMVA is running at $(public_url)"
}

cmd_update() {
  need_docker
  if git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    git -C "$ROOT" pull --ff-only
  fi
  bold "Building the new version (the current one keeps running)..."
  compose build
  cmd_backup
  drain_calls
  compose up -d --remove-orphans
  wait_ready && bold "Updated. YMVA is running at $(public_url)"
}

dev_env() {
  export ENVIRONMENT=development PUBLIC_URL=http://localhost:3000
  export DATABASE_URL="${DEV_DATABASE_URL:-postgresql+asyncpg://ymva:ymva@localhost:5432/ymva}"
  export REDIS_URL="${DEV_REDIS_URL:-redis://localhost:6379/0}"
}

docker_api_running() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 &&
    [ -n "$(compose ps -q --status running api 2>/dev/null)" ]
}

cmd_reset_admin() {
  [ -f "$ENV_FILE" ] || fail "No .env yet. Run ./ymva start first."
  if docker_api_running; then
    # Recreate the API container so it picks up the current .env, then reset.
    compose up -d api >/dev/null
    compose exec -T api ymva reset-admin
  else
    dev_env
    (cd backend && uv run --quiet ymva reset-admin)
  fi
}

cmd_restart() {
  need_docker
  drain_calls
  # `up -d` (not `restart`) so edits to .env are applied; the app itself always restarts.
  compose up -d --remove-orphans
  compose up -d --force-recreate --no-deps api web
  wait_ready && bold "YMVA is running at $(public_url)"
}

# Local development without Docker: needs PostgreSQL and Redis running locally.
cmd_dev() {
  command -v uv >/dev/null || fail "uv is required: https://docs.astral.sh/uv/"
  command -v npm >/dev/null || fail "Node.js 22+ is required."
  FIRST_RUN=0
  ensure_env
  if command -v brew >/dev/null 2>&1; then
    brew services list 2>/dev/null | grep -qE '^redis\s+started' || brew services start redis >/dev/null 2>&1 || true
  fi
  command -v pg_isready >/dev/null && { pg_isready -q || fail "PostgreSQL is not running locally."; }
  command -v redis-cli >/dev/null && { redis-cli ping >/dev/null 2>&1 || fail "Redis is not running locally."; }

  dev_env
  (cd backend && uv sync --quiet)
  [ -d web/node_modules ] || (cd web && npm install --silent)

  bold "Starting YMVA in development mode..."
  (cd backend && exec uv run ymva serve --reload) &
  local api_pid=$!
  (cd web && exec npm run dev -- --port 3000) &
  local web_pid=$!
  trap 'kill $api_pid $web_pid 2>/dev/null; wait 2>/dev/null' INT TERM EXIT
  info "Dashboard: http://localhost:3000   API docs: http://localhost:8000/api/docs"
  [ "$FIRST_RUN" = "1" ] && info "Sign in with: $(env_get ADMIN_EMAIL) / $(env_get ADMIN_PASSWORD)"
  wait
}

cmd_test() {
  bold "Backend checks"
  (cd backend && uv run ruff check src tests && uv run ruff format --check src tests && uv run mypy src && uv run pytest -q)
  bold "Dashboard checks"
  (cd web && npm run lint && npx tsc --noEmit && npm run build >/dev/null)
  bold "All checks passed."
}

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  stop) need_docker; COMPOSE_PROFILES=tunnel,ngrok compose down ;;
  restart) cmd_restart ;;
  reset-admin) cmd_reset_admin ;;
  status) need_docker; compose ps ;;
  logs) need_docker; shift; compose logs -f --tail=200 "$@" ;;
  update) cmd_update ;;
  backup) cmd_backup ;;
  verify-backup) shift; cmd_verify_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  dev) cmd_dev ;;
  test) cmd_test ;;
  simulate) need_docker; shift; compose exec -T api ymva simulate "$@" </dev/null ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
